#!/bin/sh /etc/rc.common

START=100
STOP=9
USE_PROCD=1

start_service() {
    [ "$(uci -q get forkop.settings.torrserver_direct_enabled)" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/ucode -L /usr/lib/forkop /usr/lib/forkop/torrserver/direct.uc worker
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/bin/ucode -L /usr/lib/forkop /usr/lib/forkop/torrserver/direct.uc remove >/dev/null 2>&1 || true
}
